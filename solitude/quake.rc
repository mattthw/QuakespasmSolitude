// load the base configuration
exec default.cfg

// load the last saved configuration
exec config.cfg

// run a user script file if present
exec autoexec.cfg

    // Solitude mod settings
    sv_maxspeed 200
    sv_maxvelocity 5000
    cl_forwardspeed 200
    cl_backspeed 200
    cl_sidespeed 200

    //menu music: r106 - the theme now comes from PlayMenuTheme() through the
    //looping bgmusic streamer (music/solitude_ambient_1_justin_medford.mp3).
    //This old one-shot sample double-played over it; theme.wav itself stays
    //in the pak, untouched.
    //play music/theme

    //hide console
    toggleconsole

// stuff command line statements
stuffcmds 
